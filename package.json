{
  "name": "argrail",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "sync:harnesses": "bun scripts/sync-harnesses.ts",
    "argrail": "bun packages/tooling/dist/argrail.js",
    "test": "bun test",
    "check": "bun run check:lib && bun run test:types",
    "check:lib": "tsc --noEmit",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "lint": "node node_modules/oxlint/bin/oxlint --config oxlint.config.mjs --deny-warnings --fix .",
    "format": "oxfmt --write .",
    "generate:demo": "bun packages/tooling/dist/argrail.js generate --project examples/demo",
    "check:demo": "bun packages/tooling/dist/argrail.js check --project examples/demo",
    "build:demo": "bun packages/tooling/dist/argrail.js build --project examples/demo",
    "dev:demo": "bun packages/tooling/dist/argrail.js dev --project examples/demo"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "ai-deslop": "^0.4.8",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  }
}
