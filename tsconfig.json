{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "types": ["bun"],
    "paths": {
      "@argrail/core": ["./packages/core/src/index.ts"],
      "@argrail/skills": ["./packages/skills/src/index.ts"],
      "@argrail/skills/build": ["./packages/skills/src/bundle.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
